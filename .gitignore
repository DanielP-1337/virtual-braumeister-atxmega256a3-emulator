# Share source and synthetic fixtures. Keep local firmware, evidence, and generated files out of Git.
/*
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md

!/docs/
/docs/*
!/docs/ADIW-STUDIO7.md
!/docs/CPU-CORE-EVALUATION.md
!/docs/OUT-SREG-STUDIO7.md
