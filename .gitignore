!/docs/hardware/README.md
!/docs/hardware/j6-jtag.png
!/docs/results/
/docs/results/*
!/docs/results/*.md
!/docs/results/reset-runs.json

!/scripts/
/scripts/*
!/scripts/ExportFirmware.java
!/scripts/Export_XmegaRegisterReferences.java
!/scripts/Invoke-Analysis.ps1
!/scripts/Test-Exports.ps1
!/scripts/Test-Pipeline.ps1
