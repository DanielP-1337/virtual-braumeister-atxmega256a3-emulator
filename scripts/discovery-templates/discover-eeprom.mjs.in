  result.firstApplicationInstructionCompleted = a.firstApplicationInstruction !== null;
  writeFileSync(resolve(output,'eeprom-accesses.jsonl'),a.eepromEvents.map(e=>JSON.stringify(e)+'\n').join(''));
  writeFileSync(resolve(output,'eeprom-valid.bin'),a.eepromValidity);
  if (eepromScenario === 'erased') writeFileSync(resolve(output, 'eeprom-final.bin'), a.eepromBytes);

  writeFileSync(resolve(output,'nvm-transitions.json'),JSON.stringify(a.nvmTransitions,null,2)+'\n');
  writeFileSync(resolve(output, 'gpio-accesses.jsonl'), a.gpioEvents.map(e => JSON.stringify(e) + '\n').join(''));
  writeFileSync(resolve(output, 'final-sram.bin'), a.sram);
  writeFileSync(resolve(output, 'mmio-inventory.json'), JSON.stringify(result.mmioInventory, null, 2) + '\n');
  writeFileSync(resolve(output, 'opcode-coverage.json'), JSON.stringify(result.opcodeCoverage, null, 2) + '\n');
  const f = result.firstBlockingEvent;
  writeFileSync(resolve(output, 'diagnostic-events.json'), JSON.stringify([{ origin: 'emulator', eventType: 'diagnostic', ...f }], null, 2) + '\n');
  result.coreProfile = core;
  result.eepromPageBufferEnabled = core === 'current';
  result.eepromProtectedProgrammingEnabled = core === 'current';
  result.sourceSha256 = Object.fromEntries(['src/xmega.mjs', 'src/memory-bus.mjs', 'src/peripherals/mmio-registry.mjs', 'src/peripherals/gpio.mjs', 'src/discovery.mjs', 'src/hex.mjs', 'src/peripherals/nvm.mjs', 'src/eeprom-storage.mjs', 'src/eeprom-mapping.mjs', 'tests/eeprom.test.mjs'].map(p => [p, sha(readFileSync(resolve(implementationRoot, p)))]));
  result.sourceSha256['scripts/discover-eeprom.mjs'] = sha(readFileSync(fileURLToPath(import.meta.url)));
  result.sourceSha256['scripts/eeprom-input.mjs'] = sha(readFileSync(resolve(root, 'scripts/eeprom-input.mjs')));
  result.sourceSha256['scripts/nvm-access-log.mjs'] = sha(readFileSync(resolve(root, 'scripts/nvm-access-log.mjs')));
  if (clockModule) result.sourceSha256['src/peripherals/system-clock.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/system-clock.mjs')));
  result.sourceSha256['scripts/compare-run.mjs'] = sha(readFileSync(resolve(root, 'scripts/compare-run.mjs')));
  if (Usart) result.sourceSha256['src/peripherals/usart.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/usart.mjs')));
  if (a.dfllState) result.sourceSha256['src/peripherals/dfll32m.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/dfll32m.mjs')));
  if (Osc) result.sourceSha256['src/peripherals/oscillator.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/oscillator.mjs')));
  if (Pmic) result.sourceSha256['src/peripherals/pmic.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/pmic.mjs')));
  if (Twi) result.sourceSha256['src/peripherals/twie.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/twie.mjs')));
  if (Spi) result.sourceSha256['src/peripherals/spic.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/spic.mjs')));
  if (PageBuffer) result.sourceSha256['src/peripherals/eeprom-page-buffer.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/eeprom-page-buffer.mjs')));
  if (result.eepromProtectedProgrammingEnabled) result.sourceSha256['src/peripherals/ccp.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/ccp.mjs')));
  process.exitCode = 2; // Controlled stop is NOT successful application boot.
} catch (error) { result = { status: 'HARNESS_ERROR', applicationBootSuccessful: false, reason: error.message }; process.exitCode = 1; }
writeFileSync(resolve(output, 'result.json'), JSON.stringify(result, null, 2) + '\n');
console.log(JSON.stringify({ status: result.status, completedInstructions: result.completedInstructions, cycles: result.cycles, completedApplicationInstructions: result.completedApplicationInstructions, firstBlockingEvent: result.firstBlockingEvent, reason: result.reason }, null, 2));





