    ['tcd0', 'D', a.d0CompareDState, a.d0CompareAccesses],
    ['tcd1', 'A', a.d1CompareState, a.d1CompareAccesses],
    ['tcd1', 'B', a.d1CompareBState, a.d1CompareAccesses],
  ]) {
    if (!state) continue;
    // Each channel's log includes the control aliases shared within its timer.
    const accesses = events.filter(e => e.register.startsWith('CC' + channel) || e.register.startsWith('CTRL'));
    result[timer + 'Compare' + channel] = { accesses: accesses.length, state };
    writeFileSync(resolve(output, timer + '-cc' + channel.toLowerCase() + 'buf-accesses.jsonl'), accesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.d0WaveformState) {
    result.tcd0Ctrlb = { accesses: a.d0WaveformAccesses.length, state: a.d0WaveformState, pads: a.d0Outputs };
    writeFileSync(resolve(output, 'tcd0-ctrlb-accesses.jsonl'), a.d0WaveformAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.d0ClockState) {
    result.tcd0Clock = { accesses: a.d0ClockAccesses.length, state: a.d0ClockState };
    writeFileSync(resolve(output, 'tcd0-clock-accesses.jsonl'), a.d0ClockAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.d1Clock) {
    result.tcd1Clock = a.d1Clock;
    writeFileSync(resolve(output, 'tcd1-clock-accesses.jsonl'), a.d1ClockAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.d1Ctrlb) {
    result.tcd1Ctrlb = a.d1Ctrlb;
    writeFileSync(resolve(output, 'tcd1-ctrlb-accesses.jsonl'), a.d1ControlAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.d1PeriodState) {
    result.tcd1Period = { accesses: a.d1PeriodAccesses.length, state: a.d1PeriodState };
    writeFileSync(resolve(output, 'tcd1-period-accesses.jsonl'), a.d1PeriodAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.d0PeriodState) {
    result.tcd0Period = { accesses: a.d0PeriodAccesses.length, state: a.d0PeriodState };
    writeFileSync(resolve(output, 'tcd0-period-accesses.jsonl'), a.d0PeriodAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.periodState) {
    result.tcc0Period = { accesses: a.periodAccesses.length, state: a.periodState };
    writeFileSync(resolve(output, 'tcc0-period-accesses.jsonl'), a.periodAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.counterState) {
    result.tcc0Counter = { accesses: a.counterAccesses.length, state: a.counterState };
    writeFileSync(resolve(output, 'tcc0-counter-accesses.jsonl'), a.counterAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.baudHighState) {
    result.usartF0BaudHigh = { accesses: a.baudHighAccesses.length, state: a.baudHighState };
    writeFileSync(resolve(output, 'usartf0-baudctrlb-accesses.jsonl'), a.baudHighAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.baudState) {
    result.usartF0Baud = { accesses: a.baudAccesses.length, state: a.baudState };
    writeFileSync(resolve(output, 'usartf0-baudctrla-accesses.jsonl'), a.baudAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.interruptState) {
    result.usartF0Interrupts = { accesses: a.interruptAccesses.length, state: a.interruptState };
    writeFileSync(resolve(output, 'usartf0-ctrla-accesses.jsonl'), a.interruptAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.frameState) {
    result.usartF0Format = { accesses: a.frameAccesses.length, state: a.frameState };
    writeFileSync(resolve(output, 'usartf0-ctrlc-accesses.jsonl'), a.frameAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.usartState) {
    result.usartF0 = { accesses: a.usartAccesses.length, state: a.usartState };
    writeFileSync(resolve(output, 'usartf0-accesses.jsonl'), a.usartAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.dfllState) {
    result.dfll32m = { accesses: a.dfllAccesses.length, state: a.dfllState };
    writeFileSync(resolve(output, 'dfll32m-accesses.jsonl'), a.dfllAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.references) {
    result.dfllReference = { accesses: a.oscAccesses.filter(e => e.referenceAfter).length, state: a.references };
  }
  if (Osc) {
    result.oscillator = { profile: oscTiming, cpuClockHz: a.clockState?.cpuClockHz ?? 2000000, startupCycles: { rc32m: oscStartupCycles.rc32m ?? null, rc32k: oscStartupCycles.rc32k ?? null },
      accesses: a.oscAccesses.length, state: a.oscState };
    writeFileSync(resolve(output, 'osc-accesses.jsonl'), a.oscAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.portInterruptState) {
    result.porteInterrupts = { accesses: a.portInterruptAccesses.length, state: a.portInterruptState };
    writeFileSync(resolve(output, 'porte-interrupt-accesses.jsonl'), a.portInterruptAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (a.spieState) {
    result.spie = { accesses: a.spieAccesses.length, transfers: a.spieTransfers.length, state: a.spieState };
    writeFileSync(resolve(output, 'spie-accesses.jsonl'), a.spieAccesses.map(e => JSON.stringify(e) + '\n').join(''));
    writeFileSync(resolve(output, 'spie-transfers.jsonl'), a.spieTransfers.map(e => JSON.stringify(e) + '\n').join(''));
  }
  if (Spi) {
    const accesses = a.diagnostic.mmioInventory.filter(row => row.addressByte >= 0x08c0 && row.addressByte <= 0x08c3);
    result.spicAccesses = a.spiAccesses.length;
    result.spicAttemptedAccesses = accesses.reduce((sum, row) => sum + row.count, 0);
    result.spicCompletedTransfers = a.spiTransfers.filter(event => event.action === 'complete').length;
    result.spicState = a.spiState;
    for (const [file, events] of [['spic-accesses', a.spiAccesses], ['spic-transfers', a.spiTransfers]]) {
      writeFileSync(resolve(output, file + '.jsonl'), events.map(e => JSON.stringify(e) + '\n').join(''));
    }
  }
  if (Twi) {
    result.twieState = a.twiState;
    result.twieAttemptedAccesses = a.twiEvidence.accesses.length;
    result.twieCompletedAccesses = a.twiEvidence.accesses.filter(e => e.completed).length;
    result.twieBusEvents = a.twiEvidence.transfers.length;
    result.twieInterruptAssertions = a.twiEvidence.interrupts.filter(e => e.asserted).length;
    for (const [name, events] of Object.entries(a.twiEvidence)) {
      writeFileSync(resolve(output, 'twie-' + name + '.jsonl'), events.map(e => JSON.stringify(e) + '\n').join(''));
    }
  }
  if (Pmic) {
    result.pmicState = a.pmicState;
    result.pmicAccesses = a.pmicAccesses.length;
    writeFileSync(resolve(output, 'pmic-accesses.jsonl'), a.pmicAccesses.map(e => JSON.stringify(e) + '\n').join(''));
  }
  result.integrity = a.integrity;
  result.nonvolatileMemoryPreserved = a.integrity.initialFlashSha256 === a.integrity.finalFlashSha256 && a.integrity.changedOffsets.length === 0;
  result.uniqueCompletedApplicationPcWords = a.applicationPCs;
  result.firstApplicationInstructionCompleted = a.firstApplicationInstruction !== null;
  writeFileSync(resolve(output,'eeprom-accesses.jsonl'),a.eepromEvents.map(e=>JSON.stringify(e)+'\n').join(''));
  writeFileSync(resolve(output,'eeprom-valid.bin'),a.eepromValidity);
  if (eepromScenario === 'erased') writeFileSync(resolve(output, 'eeprom-final.bin'), a.eepromBytes);

  writeFileSync(resolve(output,'nvm-transitions.json'),JSON.stringify(a.nvmTransitions,null,2)+'\n');
  writeFileSync(resolve(output, 'gpio-accesses.jsonl'), a.gpioEvents.map(e => JSON.stringify(e) + '\n').join(''));
  writeFileSync(resolve(output, 'final-sram.bin'), a.sram);
  writeFileSync(resolve(output, 'mmio-inventory.json'), JSON.stringify(result.mmioInventory, null, 2) + '\n');
  writeFileSync(resolve(output, 'opcode-coverage.json'), JSON.stringify(result.opcodeCoverage, null, 2) + '\n');
  const f = result.firstBlockingEvent;
  writeFileSync(resolve(output, 'diagnostic-events.json'), JSON.stringify([{ origin: 'emulator', eventType: 'diagnostic', ...f }], null, 2) + '\n');
  result.coreProfile = core;
  result.eepromPageBufferEnabled = core === 'current';
  result.eepromProtectedProgrammingEnabled = core === 'current';
  result.sourceSha256 = Object.fromEntries(['src/xmega.mjs', 'src/memory-bus.mjs', 'src/peripherals/mmio-registry.mjs', 'src/peripherals/gpio.mjs', 'src/discovery.mjs', 'src/hex.mjs', 'src/peripherals/nvm.mjs', 'src/eeprom-storage.mjs', 'src/eeprom-mapping.mjs', 'tests/eeprom.test.mjs'].map(p => [p, sha(readFileSync(resolve(implementationRoot, p)))]));
  result.sourceSha256['scripts/discover-eeprom.mjs'] = sha(readFileSync(fileURLToPath(import.meta.url)));
  result.sourceSha256['scripts/eeprom-input.mjs'] = sha(readFileSync(resolve(root, 'scripts/eeprom-input.mjs')));
  result.sourceSha256['scripts/spic-input.mjs'] = sha(readFileSync(resolve(root, 'scripts/spic-input.mjs')));
  result.sourceSha256['scripts/portf-input.mjs'] = sha(readFileSync(resolve(root, 'scripts/portf-input.mjs')));
  result.sourceSha256['scripts/pe2-input.mjs'] = sha(readFileSync(resolve(root, 'scripts/pe2-input.mjs')));
  result.sourceSha256['scripts/production-signature-input.mjs'] = sha(readFileSync(resolve(root, 'scripts/production-signature-input.mjs')));
  result.sourceSha256['scripts/nvm-access-log.mjs'] = sha(readFileSync(resolve(root, 'scripts/nvm-access-log.mjs')));
  if (clockModule) result.sourceSha256['src/peripherals/system-clock.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/system-clock.mjs')));
  result.sourceSha256['scripts/compare-run.mjs'] = sha(readFileSync(resolve(root, 'scripts/compare-run.mjs')));
  if (TimerInterrupts) result.sourceSha256['src/peripherals/tcc0-intctrla.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/tcc0-intctrla.mjs')));
  if (Waveform || D0Waveform) result.sourceSha256['src/peripherals/tc0-ctrlb.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/tc0-ctrlb.mjs')));
  if (Waveform) result.sourceSha256['src/peripherals/tcc0-ctrlb.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/tcc0-ctrlb.mjs')));
  if (TimerClock) result.sourceSha256['src/peripherals/tcc0-clock.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/tcc0-clock.mjs')));
  if (TimerClock || D0Clock || TimerD1) result.sourceSha256['src/peripherals/timer-clock.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/timer-clock.mjs')));
  if (TimerClock || D0Clock) result.sourceSha256['src/peripherals/tc0-clock.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/tc0-clock.mjs')));
  if (Counter || TimerD0) result.sourceSha256['src/peripherals/tc0-compare.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/tc0-compare.mjs')));
  if (Counter || TimerD0) result.sourceSha256['src/peripherals/tc0-compare-c.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/tc0-compare-c.mjs')));
  if (Adca) result.sourceSha256['src/peripherals/adca.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/adca.mjs')));
  if (DACB) result.sourceSha256['src/peripherals/dacb.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/dacb.mjs')));
  if (TimerD1) result.sourceSha256['src/peripherals/tcd1-period.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/tcd1-period.mjs')));
  if (Counter || TimerD0 || TimerD1) result.sourceSha256['src/peripherals/timer-compare.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/timer-compare.mjs')));
  if (Counter || TimerD0 || TimerD1 || Waveform || D0Waveform) result.sourceSha256['src/peripherals/timer-waveform.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/timer-waveform.mjs')));
  if (Counter || TimerD0 || TimerD1) result.sourceSha256['src/peripherals/timer-registers.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/timer-registers.mjs')));
  if (Counter || TimerD0) result.sourceSha256['src/peripherals/tc0-counter.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/tc0-counter.mjs')));
  if (Counter) result.sourceSha256['src/peripherals/tcc0-counter.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/tcc0-counter.mjs')));
  if (BaudHigh) result.sourceSha256['src/peripherals/usart-baud-high.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/usart-baud-high.mjs')));
  if (BaudControl) result.sourceSha256['src/peripherals/usart-baud.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/usart-baud.mjs')));
  if (InterruptControl) result.sourceSha256['src/peripherals/usart-interrupts.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/usart-interrupts.mjs')));
  if (Frame) result.sourceSha256['src/peripherals/usart-frame.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/usart-frame.mjs')));
  if (Usart) result.sourceSha256['src/peripherals/usart.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/usart.mjs')));
  if (a.dfllState) result.sourceSha256['src/peripherals/dfll32m.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/dfll32m.mjs')));
  if (Osc) result.sourceSha256['src/peripherals/oscillator.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/oscillator.mjs')));
  if (Pmic) result.sourceSha256['src/peripherals/pmic.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/pmic.mjs')));
  if (Twi) result.sourceSha256['scripts/twie-input.mjs'] = sha(readFileSync(resolve(root, 'scripts/twie-input.mjs')));
  if (Twi) result.sourceSha256['src/peripherals/twie.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/twie.mjs')));
  if (PortEInterrupts) result.sourceSha256['src/peripherals/porte-interrupts.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/porte-interrupts.mjs')));
  if (Spi) result.sourceSha256['src/peripherals/spic.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/spic.mjs')));
  if (PageBuffer) result.sourceSha256['src/peripherals/eeprom-page-buffer.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/eeprom-page-buffer.mjs')));
  if (result.eepromProtectedProgrammingEnabled) result.sourceSha256['src/peripherals/ccp.mjs'] = sha(readFileSync(resolve(root, 'src/peripherals/ccp.mjs')));
  process.exitCode = 2; // Controlled stop is NOT successful application boot.
} catch (error) { result = { status: 'HARNESS_ERROR', applicationBootSuccessful: false, reason: error.message }; process.exitCode = 1; }
writeFileSync(resolve(output, 'result.json'), JSON.stringify(result, null, 2) + '\n');
console.log(JSON.stringify({ status: result.status, completedInstructions: result.completedInstructions, cycles: result.cycles, completedApplicationInstructions: result.completedApplicationInstructions, firstBlockingEvent: result.firstBlockingEvent, reason: result.reason }, null, 2));





